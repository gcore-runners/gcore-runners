#!/bin/zsh
# cal add|list|del|export — события в календаре macOS «Claude» (синхронизируется через iCloud, если включить у календаря)
# cal add "Название" ГГГГ-ММ-ДД [ЧЧ:ММ] [-n "заметка"] [-r daily|weekly|monthly|yearly]     без времени = на весь день; -r = одно повторяющееся событие
# cal list [today|tomorrow|week|month|overdue|ГГГГ-ММ-ДД] [--hook]     overdue = невыполненное за прошлые дни (не удалённое из календаря, без повторяющихся), глубина CAL_OVERDUE_DAYS, по умолчанию 60
# cal del "Название" ГГГГ-ММ-ДД
# cal export файл.ics [дней вперёд, по умолчанию 365]
CAL="Claude"
cmd=$1; shift
ymd() { date -j -v${1} +%Y-%m-%d 2>/dev/null; }
valid_date() { [[ $1 =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' ]] && date -j -f %Y-%m-%d "$1" +%Y-%m-%d >/dev/null 2>&1; }

# AppleScript: общий кусок, превращает "ГГГГ-ММ-ДД" и "ЧЧ:ММ" в date без зависимости от локали
read -r -d '' LIB <<'A'
on mkDate(ymd, hm)
  set d to current date
  set day of d to 1
  set year of d to (text 1 thru 4 of ymd) as integer
  set month of d to (text 6 thru 7 of ymd) as integer
  set day of d to (text 9 thru 10 of ymd) as integer
  if hm is "" then
    set time of d to 0
  else
    set time of d to ((text 1 thru 2 of hm) as integer) * 3600 + ((text 4 thru 5 of hm) as integer) * 60
  end if
  return d
end mkDate
on pad(n)
  return text -2 thru -1 of ("0" & n)
end pad
on fmtDate(d)
  return ((year of d) as string) & "-" & pad(month of d as integer) & "-" & pad(day of d)
end fmtDate
on getCal(nm)
  tell application "Calendar"
    if not (exists calendar nm) then make new calendar with properties {name:nm}
    return calendar nm
  end tell
end getCal
A

# выбор событий за период: строки «дата<TAB>время<TAB>весь день<TAB>дата конца<TAB>время конца<TAB>название»
fetch_raw() {
  osascript - "$CAL" "$1" "$2" <<A 2>/dev/null
$LIB
on run argv
  tell application "Calendar"
    if not (exists calendar (item 1 of argv)) then return ""
    set c to calendar (item 1 of argv)
    set s to my mkDate(item 2 of argv, "")
    set e to (my mkDate(item 3 of argv, "")) + 1 * days
    set res to ""
    repeat with ev in (every event of c whose start date < e)
      set rr to ""
      try
        set rr to recurrence of ev
        if rr is missing value then set rr to ""
      end try
      set sd to start date of ev
      set ed to end date of ev
      if rr is not "" or ed > s then
        set res to res & (my fmtDate(sd)) & tab & (my pad(hours of sd)) & ":" & (my pad(minutes of sd)) & tab & (allday event of ev) & tab & (my fmtDate(ed)) & tab & (my pad(hours of ed)) & ":" & (my pad(minutes of ed)) & tab & (summary of ev) & tab & rr & linefeed
      end if
    end repeat
    return res
  end tell
end run
A
}

# то же, но повторяющиеся события развёрнуты во вхождения внутри периода
HERE=${0:A:h}
fetch() { fetch_raw $1 $2 | $HERE/cal-expand $1 $2; }

# невыполненное: одиночные события, целиком закончившиеся до сегодняшнего дня (выполненное пользователь удаляет из календаря)
overdue() {
  local t=$(date +%Y-%m-%d) from=$(ymd -${CAL_OVERDUE_DAYS:-60}d) y=$(ymd -1d)
  fetch_raw $from $y | awk -F'\t' -v t=$t 'NF>=6 && $7=="" && $1<t && $4<t{ if($3=="true") $2="весь день"; print $1 "\t" $2 "\t" $6 }' OFS='\t' | sort
}

case $cmd in
add)
  title=$1; day=$2; shift 2 2>/dev/null
  tm=""; note=""
  [[ $1 =~ '^[0-9]{1,2}:[0-9]{2}$' ]] && { tm=$1; [[ ${#tm} -eq 4 ]] && tm="0$tm"; shift; }
  rule=""
  while (( $# )); do
    case $1 in
      -n) note=$2; shift 2 ;;
      -r) case $2 in
            daily) rule="FREQ=DAILY;INTERVAL=1" ;;
            weekly) rule="FREQ=WEEKLY;INTERVAL=1" ;;
            monthly) rule="FREQ=MONTHLY;INTERVAL=1" ;;
            yearly) rule="FREQ=YEARLY;INTERVAL=1" ;;
            FREQ=*) rule=$2 ;;
            *) echo "Повтор: daily|weekly|monthly|yearly или правило FREQ=…" >&2; exit 2 ;;
          esac; shift 2 ;;
      *) shift ;;
    esac
  done
  if [[ -z $title ]] || ! valid_date "$day"; then echo "Использование: cal add \"Название\" ГГГГ-ММ-ДД [ЧЧ:ММ] [-n заметка]" >&2; exit 2; fi
  osascript - "$CAL" "$title" "$day" "$tm" "$note" "$rule" >/dev/null <<A || { echo "Не записано: Calendar не ответил (нет доступа или окно запроса ждёт на экране)" >&2; exit 1; }
$LIB
on run argv
  set c to getCal(item 1 of argv)
  set s to mkDate(item 3 of argv, item 4 of argv)
  tell application "Calendar"
    if (item 4 of argv) is "" then
      set ev to make new event at end of events of c with properties {summary:item 2 of argv, start date:s, end date:s + 1 * days - 1, allday event:true, description:item 5 of argv}
    else
      set ev to make new event at end of events of c with properties {summary:item 2 of argv, start date:s, end date:s + 1 * hours, description:item 5 of argv}
    end if
    if (item 6 of argv) is not "" then set recurrence of ev to (item 6 of argv)
  end tell
end run
A
  echo "Добавлено: $day ${tm:-весь день} — $title" ;;
list)
  what=${1:-today}; hook=0; [[ $2 == --hook ]] && hook=1
  case $what in
    today) a=$(date +%Y-%m-%d); b=$a ;;
    tomorrow) a=$(ymd +1d); b=$a ;;
    week) a=$(date +%Y-%m-%d); b=$(ymd +6d) ;;
    month) a=$(date +%Y-%m-%d); b=$(ymd +30d) ;;
    overdue)
      od=$(overdue)
      [[ -z $od ]] && echo "Просроченного нет" || print -r -- "$od" | awk -F'\t' '{printf "%s  %-10s %s\n",$1,$2,$3}'
      exit 0 ;;
    *) valid_date "$what" || { echo "Неверная дата: $what" >&2; exit 2; }; a=$what; b=$what ;;
  esac
  out=$(fetch $a $b | sort)
  # весь день: показываем «весь день» вместо 00:00
  out=$(print -r -- "$out" | awk -F'\t' 'NF>=6{ if($3=="true") $2="весь день"; print $1 "\t" $2 "\t" $6 }' OFS='\t')
  if (( hook )); then
    od=$(overdue)
    [[ -z $out && -z $od ]] && exit 0
    msg=""; ctx=""
    if [[ -n $out ]]; then
      lines=$(print -r -- "$out" | awk -F'\t' '{printf "• %s — %s\n",$2,$3}')
      short=$(print -r -- "$out" | awk -F'\t' '{printf "%s (%s); ",$3,$2}')
      msg="📅 На сегодня запланировано:
$lines"
      ctx="КАЛЕНДАРЬ НА СЕГОДНЯ ($a). В первом же ответе напомни пользователю одной-двумя строками: $short"
    fi
    if [[ -n $od ]]; then
      olines=$(print -r -- "$od" | awk -F'\t' '{printf "• %s — %s\n",$1,$3}')
      oshort=$(print -r -- "$od" | awk -F'\t' '{printf "%s (с %s); ",$3,$1}')
      msg+="${msg:+

}⏰ Не выполнено за прошлые дни:
$olines"
      ctx+="${ctx:+ }КАЛЕНДАРЬ, НЕ ВЫПОЛНЕНО ЗА ПРОШЛЫЕ ДНИ: $oshort Назови их пользователю в первом ответе. Выполненное пользователь удаляет из календаря: когда он скажет «готово» по задаче, удали её командой cal del \"Название\" ГГГГ-ММ-ДД (дата из списка); на «перенеси» сделай del + add на новую дату."
    fi
    jq -n --arg m "$msg" --arg c "$ctx" '{systemMessage:$m,hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$c}}'
  else
    [[ -z $out ]] && echo "Ничего не запланировано ($a … $b)" || print -r -- "$out" | awk -F'\t' '{printf "%s  %-10s %s\n",$1,$2,$3}'
  fi ;;
del)
  if [[ -z $1 ]] || ! valid_date "$2"; then echo "Использование: cal del \"Название\" ГГГГ-ММ-ДД" >&2; exit 2; fi
  osascript - "$CAL" "$1" "$2" <<A || { echo "Не удалено: Calendar не ответил или календаря нет" >&2; exit 1; }
$LIB
on run argv
  tell application "Calendar"
    set c to calendar (item 1 of argv)
    set s to my mkDate(item 3 of argv, "")
    delete (every event of c whose summary is (item 2 of argv) and start date ≥ s and start date < s + 1 * days)
  end tell
end run
A
  echo "Удалено (если было): $2 — $1" ;;
export)
  f=${1:?Использование: cal export файл.ics [дней]}; n=${2:-365}
  a=$(date +%Y-%m-%d); b=$(ymd +${n}d); stamp=$(date -u +%Y%m%dT%H%M%SZ)
  { print -n "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//GorbunCore//calendar//RU\r\nX-WR-CALNAME:Claude\r\n"
    fetch $a $b | awk -F'\t' -v st=$stamp 'NF>=6{ d1=$1; d2=$4; t1=$2; t2=$5; gsub(/-/,"",d1); gsub(/-/,"",d2); gsub(/:/,"",t1); gsub(/:/,"",t2);
      printf "BEGIN:VEVENT\r\nUID:%s-%s-%d@gcore\r\nDTSTAMP:%s\r\n", d1,t1,NR,st;
      if($3=="true") { cmd="date -j -v+1d -f %Y%m%d " d2 " +%Y%m%d"; cmd | getline d2n; close(cmd); printf "DTSTART;VALUE=DATE:%s\r\nDTEND;VALUE=DATE:%s\r\n",d1,d2n } else printf "DTSTART:%sT%s00\r\nDTEND:%sT%s00\r\n",d1,t1,d2,t2;
      printf "SUMMARY:%s\r\nEND:VEVENT\r\n",$6 }'
    print -n "END:VCALENDAR\r\n"; } > "$f"
  echo "Выгружено в $f" ;;
*) echo "cal add|list|del|export" >&2; exit 2 ;;
esac
